{
  "name": "@unishare-oss/unitheme",
  "version": "0.2.0",
  "license": "UNLICENSED",
  "type": "module",
  "description": "Shared UniCorp theme palettes, React provider, picker and account preference adapters",
  "repository": { "type": "git", "url": "https://github.com/unishare-oss/unitheme.git" },
  "publishConfig": { "registry": "https://npm.pkg.github.com" },
  "files": ["dist", "README.md"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs", "default": "./dist/index.js" },
    "./react": { "types": "./dist/react.d.ts", "default": "./dist/react.js" },
    "./themes.css": "./dist/themes.css",
    "./picker.css": "./dist/picker.css"
  },
  "scripts": {
    "build": "bun scripts/generate.ts && tsc && bun scripts/copy-css.ts && bun build src/index.ts --outfile dist/index.cjs --target node --format cjs",
    "test": "bun test",
    "prepack": "bun run build"
  },
  "peerDependencies": { "react": ">=19", "react-dom": ">=19" },
  "peerDependenciesMeta": { "react": { "optional": true }, "react-dom": { "optional": true } },
  "devDependencies": { "@types/bun": "^1.4.2", "@types/react": "^19.2.17", "@types/react-dom": "^19.2.3", "react": "^19.2.5", "react-dom": "^19.2.5", "typescript": "^5.9.3" }
}
